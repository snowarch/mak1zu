# The owner's playground instance as a user service. Not installed on purpose:
# copy to ~/.config/systemd/user/mak1zu.service, then: systemctl --user enable --now mak1zu
[Unit]
Description=Mak1zu companion (the playground instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/mak1zu -c %h/mak1zu-playground/.makizu/config.json run
WorkingDirectory=%h/mak1zu-playground/.makizu
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
